{
  // Terminal > Run Task... to use these. Or type the same npm commands in the terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Install packages (first time)",
      "type": "npm",
      "script": "install",
      "problemMatcher": []
    },
    {
      "label": "2. Start app (dev server)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run tests",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Build for hosting (creates dist/)",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ]
}
