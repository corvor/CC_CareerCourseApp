{
  // Terminal > Run Task... > "Run app (Python)" if you'd rather not install Live Server.
  // Then open http://localhost:8000 in your browser. Stop it with Ctrl+C in the terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run app (Python)",
      "type": "shell",
      "command": "python -m http.server 8000",
      "windows": { "command": "py -m http.server 8000" },
      "options": { "cwd": "${workspaceFolder}/App" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
